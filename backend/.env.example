# Copy this file to backend/.env and edit ONLY backend/.env. Never commit it.
# Leave blank until you have an API key. X-Ray works without an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# By default URL scanning is OFF to reduce exposure; HTML input works.
AIRLOCK_ENABLE_URL_SCAN=0
AIRLOCK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FOR LOCAL DEVELOPMENT ONLY if Chromium's OS sandbox is unavailable.
# NEVER set this to 1 in a public deployment.
AIRLOCK_DEV_NO_BROWSER_SANDBOX=0

# Optional custom Chromium executable path, mainly for debugging.
AIRLOCK_CHROMIUM_EXECUTABLE=
